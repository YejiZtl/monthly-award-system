# 复制为 .env 后按部署环境填写；不要提交真实密钥。
APP_ENV=development
DATABASE_PATH=/data/monthly_award.sqlite3
UPLOAD_ROOT=/data/uploads
EXPORT_ROOT=/data/exports
TEMPLATE_PATH=/app/templates/excel/monthly_award_official_v2026_07.xlsx
RULE_VERSION=RV-2026.08
TEMPLATE_VERSION=TMPL-2026.07
PROMPT_VERSION=PROMPT-2026.08
INLINE_WORKER=false

# 智谱免费视觉模型；ZAI_API_KEY 留空时图片自动转人工录入。
LLM_PROVIDER=bigmodel
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
ZAI_API_KEY=
LLM_MODEL=glm-4.6v-flash
LLM_TEMPERATURE=0.1
LLM_ENABLE_THINKING=false
LLM_TIMEOUT_SECONDS=120
LLM_MAX_ATTEMPTS=3
LLM_IMAGE_MAX_EDGE=2200
LLM_IMAGE_QUALITY=92

# 如需切回其他 OpenAI 兼容服务，设置 LLM_PROVIDER=openai_compatible，并使用 LLM_API_KEY。
LLM_API_KEY=

# APP_ENV=production 时以下三项必须设置为高强度随机值。
REVIEWER_TOKEN=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
